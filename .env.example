# ==============================================================================
# O.D.I.N. Environment Variables Template (.env.example)
# Phase 2 — v1.2 JARVIS Interface & Knowledge Hub
#
# Instructions:
# 1. Copy this file to `.env.local` for local development:
#    cp .env.example .env.local
# 2. Populate the required values below.
# 3. NEVER commit `.env.local` or any secrets to version control.
# 4. In Vercel (Production), configure these under Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cognitive Reasoning Engine (Google Gemini)
# ------------------------------------------------------------------------------
# Google Gemini API key obtained from Google AI Studio (https://aistudio.google.com/).
# SERVER-SIDE ONLY: Do NOT prefix with NEXT_PUBLIC_.
GEMINI_API_KEY="your-gemini-api-key-here"

# Cognitive Engine Model String (Pinned per ARCHITECTURE.md)
GEMINI_MODEL="gemini-3.6-flash"

# ------------------------------------------------------------------------------
# 2. Database & Vector Storage (Supabase - Postgres + pgvector)
# ------------------------------------------------------------------------------
# Supabase project URL (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anonymous Client Key (Safe for browser / protected by Row-Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# Supabase Service Role Key (SERVER-SIDE ONLY - bypasses RLS for system operations)
# CAUTION: Never expose this key in client-side code or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# ------------------------------------------------------------------------------
# 3. Application-Layer Security & Encryption
# ------------------------------------------------------------------------------
# 32-byte secret key (64 hex characters) for Node.js `crypto` AES-256-GCM encryption
# Used to encrypt `raw_narrative` and `session_outcomes.narrative` before DB write.
#
# Generate a secure 32-byte key:
#   PowerShell: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
#   Node.js:    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   OpenSSL:    openssl rand -hex 32
APP_ENCRYPTION_KEY="your-64-character-hex-encryption-key-here"
